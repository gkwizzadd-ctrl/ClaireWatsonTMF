      "id": "mr-read-0003",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 360],
      "parameters": {
        "jsCode": "// alwaysOutputData emits a placeholder for an empty sheet, and a header-only sheet can hand back the header row mapped onto itself ('Member Name': 'Member Name') -- drop both, and any row without a name.\nconst rows = $input.all()\n  .map(item => item.json)\n  .filter(r => r['Member Name'] && r['Member Name'] !== 'Member Name');\n// Same shape the old Apps Script read returned for this tab, so the page needs no other change.\nreturn [{ json: { success: true, Members: rows } }];"
      }
    },
    {
      "id": "mr-read-0004",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
